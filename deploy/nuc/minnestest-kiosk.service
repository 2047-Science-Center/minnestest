# systemd USER-tjänst: startar kiosk-fönstret (Chrome) i den grafiska sessionen.
# Installeras av install.sh till ~/.config/systemd/user/ (@REPO@ ersätts där).
# Kräver att NUC:en loggar in automatiskt till en X11-session (se NUC-INSTALL.md).
[Unit]
Description=FLYKTEN — kiosk (Chrome, en skärm)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@REPO@/deploy/nuc/kiosk.sh
# on-failure (inte always): "Avsluta"-knappen (window.close → ren exit) avslutar
# faktiskt appen och tystnar; bara en KRASCH startar om kiosken.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
